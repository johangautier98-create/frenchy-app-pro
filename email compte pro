<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Frenchy Leurres — Votre compte professionnel</title>
</head>
<body style="margin:0;padding:0;background:#f4f4f0;font-family:'Helvetica Neue',Arial,sans-serif;">

<table width="100%" cellpadding="0" cellspacing="0" style="background:#f4f4f0;padding:40px 20px;">
  <tr><td align="center">

    <!-- CARTE PRINCIPALE -->
    <table width="600" cellpadding="0" cellspacing="0" style="max-width:600px;width:100%;background:#ffffff;border-radius:16px;overflow:hidden;box-shadow:0 4px 24px rgba(0,0,0,.10);">

      <!-- HEADER DORÉ -->
      <tr>
        <td style="background:#1a1a1a;padding:36px 40px;text-align:center;">
          <div style="font-size:36px;margin-bottom:12px;">🎣</div>
          <div style="color:#e8c840;font-size:22px;font-weight:900;letter-spacing:1px;">FRENCHY LEURRES</div>
          <div style="color:#888;font-size:13px;margin-top:4px;letter-spacing:2px;text-transform:uppercase;">Leurres artisanaux — Port-de-Bouc</div>
        </td>
      </tr>

      <!-- BANDE ACCENT -->
      <tr>
        <td style="background:#e8c840;padding:10px 40px;">
          <div style="color:#1a1a1a;font-size:13px;font-weight:800;text-align:center;letter-spacing:.5px;">✅ VOTRE COMPTE PROFESSIONNEL EST CRÉÉ</div>
        </td>
      </tr>

      <!-- CORPS -->
      <tr>
        <td style="padding:36px 40px;">

          <p style="color:#1a1a1a;font-size:16px;line-height:1.6;margin:0 0 20px;">
            Bonjour <strong>{{PRENOM}}</strong>,
          </p>

          <p style="color:#444;font-size:14px;line-height:1.7;margin:0 0 28px;">
            Nous avons le plaisir de vous confirmer l'ouverture de votre compte professionnel <strong>Frenchy Leurres</strong>.
            Votre compte est actuellement <strong>en cours de validation</strong>. Vous trouverez ci-dessous vos identifiants de connexion.
          </p>

          <!-- BLOC IDENTIFIANTS -->
          <table width="100%" cellpadding="0" cellspacing="0" style="background:#f8f8f4;border:2px solid #e8c840;border-radius:12px;margin-bottom:28px;">
            <tr>
              <td style="padding:20px 24px;">
                <div style="font-size:11px;font-weight:900;color:#888;text-transform:uppercase;letter-spacing:1px;margin-bottom:16px;">Vos identifiants</div>
                <table width="100%" cellpadding="0" cellspacing="0">
                  <tr>
                    <td style="padding:8px 0;border-bottom:1px solid #e8e6e0;">
                      <span style="color:#888;font-size:13px;">Enseigne</span>
                    </td>
                    <td style="padding:8px 0;border-bottom:1px solid #e8e6e0;text-align:right;">
                      <strong style="color:#1a1a1a;font-size:14px;">{{NOM_MAGASIN}}</strong>
                    </td>
                  </tr>
                  <tr>
                    <td style="padding:8px 0;border-bottom:1px solid #e8e6e0;">
                      <span style="color:#888;font-size:13px;">Identifiant</span>
                    </td>
                    <td style="padding:8px 0;border-bottom:1px solid #e8e6e0;text-align:right;">
                      <strong style="color:#1a1a1a;font-size:14px;">{{LOGIN}}</strong>
                    </td>
                  </tr>
                  <tr>
                    <td style="padding:8px 0;">
                      <span style="color:#888;font-size:13px;">Mot de passe</span>
                    </td>
                    <td style="padding:8px 0;text-align:right;">
                      <strong style="color:#e8c840;font-size:16px;font-family:monospace;background:#1a1a1a;padding:4px 10px;border-radius:6px;">{{MOT_DE_PASSE}}</strong>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
          </table>

          <!-- BOUTON CONNEXION -->
          <table width="100%" cellpadding="0" cellspacing="0" style="margin-bottom:32px;">
            <tr>
              <td align="center">
                <a href="https://www.frenchyleurres.fr/account/login"
                   style="display:inline-block;background:#1a1a1a;color:#e8c840;font-size:15px;font-weight:900;padding:16px 40px;border-radius:10px;text-decoration:none;letter-spacing:.5px;">
                  🔐 Accéder à mon compte
                </a>
              </td>
            </tr>
          </table>

          <!-- BLOC SEPA -->
          <table width="100%" cellpadding="0" cellspacing="0" style="background:#fff8e1;border-left:4px solid #e8c840;border-radius:0 8px 8px 0;margin-bottom:28px;">
            <tr>
              <td style="padding:18px 20px;">
                <div style="font-size:13px;font-weight:900;color:#7a5800;margin-bottom:8px;">📋 PROCHAINE ÉTAPE — MANDAT SEPA</div>
                <p style="color:#7a5800;font-size:13px;line-height:1.6;margin:0;">
                  Pour activer le <strong>paiement différé</strong>, vous allez recevoir un email de notre partenaire <strong>Stripe</strong> vous demandant de signer un mandat SEPA.<br><br>
                  ⚠️ <strong>Merci de signer ce mandat dès réception</strong> — sans signature, votre compte ne pourra pas être pleinement activé.
                </p>
              </td>
            </tr>
          </table>

          <!-- CONDITIONS si renseignées -->
          {{#SI_CONDITIONS}}
          <table width="100%" cellpadding="0" cellspacing="0" style="background:#f0f8f0;border:1px solid #c8e6c9;border-radius:8px;margin-bottom:28px;">
            <tr>
              <td style="padding:16px 20px;">
                <div style="font-size:11px;font-weight:900;color:#2e7d32;text-transform:uppercase;letter-spacing:1px;margin-bottom:8px;">✅ Vos conditions commerciales</div>
                <p style="color:#1a5e20;font-size:13px;line-height:1.6;margin:0;">{{CONDITIONS}}</p>
              </td>
            </tr>
          </table>
          {{/SI_CONDITIONS}}

          <p style="color:#888;font-size:13px;line-height:1.6;margin:0 0 8px;">
            Une fois votre compte activé, <strong>vos tarifs professionnels</strong> seront visibles automatiquement sur notre boutique en ligne.
          </p>
          <p style="color:#888;font-size:13px;line-height:1.6;margin:0;">
            Pour toute question, n'hésitez pas à nous contacter directement.
          </p>

        </td>
      </tr>

      <!-- FOOTER SIGNATURE -->
      <tr>
        <td style="background:#f8f8f4;border-top:1px solid #e8e6e0;padding:28px 40px;">
          <table width="100%" cellpadding="0" cellspacing="0">
            <tr>
              <td>
                <div style="font-size:14px;font-weight:900;color:#1a1a1a;margin-bottom:4px;">Mr Gautier Johan</div>
                <div style="font-size:13px;color:#555;margin-bottom:8px;">GAUTIER FISHING — FRENCHY LEURRES</div>
                <div style="font-size:12px;color:#888;line-height:1.8;">
                  📍 8, chemin campagne roque — 13110 Port-de-Bouc<br>
                  📞 07 83 21 07 58<br>
                  ✉ gautierfishing@gmail.com<br>
                  🌐 www.frenchyleurres.fr<br>
                  SIRET : 48359538500038
                </div>
              </td>
              <td align="right" valign="top">
                <div style="font-size:32px;">🎣</div>
              </td>
            </tr>
          </table>
        </td>
      </tr>

      <!-- BAS DE PAGE -->
      <tr>
        <td style="background:#1a1a1a;padding:16px 40px;text-align:center;">
          <div style="color:#555;font-size:11px;">
            Frenchy Leurres · Leurres artisanaux · Port-de-Bouc, France<br>
            <span style="color:#e8c840;">frenchyleurres.fr</span>
          </div>
        </td>
      </tr>

    </table>
    <!-- FIN CARTE -->

  </td></tr>
</table>

</body>
</html>
